<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!-- Top Red Header (Phong cách TupeShop) -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E53935"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:elevation="4dp">

        <!-- Header Top Row: Brand & Notification -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TupeShop"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <ImageView
                android:id="@+id/ivBell"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_bell"
                app:tint="#FFFFFF"/>

        </LinearLayout>

        <!-- Search Bar (Bo tròn nền trắng) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="#757575"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Bạn muốn mua gì ?"
                android:textColorHint="#9E9E9E"
                android:textColor="#212121"
                android:textSize="13sp"
                android:background="@null"
                android:singleLine="true"
                android:imeOptions="actionSearch"/>

            <TextView
                android:id="@+id/tvAiSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hỏi AI"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: TRANG CHỦ (DANH SÁCH SẢN PHẨM) -->
        <LinearLayout
            android:id="@+id/panelProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sản phẩm nổi bật"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <Button
                    android:id="@+id/btnAddProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Thêm"
                    android:textSize="12sp"
                    android:backgroundTint="#E53935"
                    android:textColor="#FFFFFF"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:clipToPadding="false"/>

        </LinearLayout>

        <!-- TAB 2: GIỎ HÀNG -->
        <LinearLayout
            android:id="@+id/panelCart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛒 Giỏ hàng của tôi"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:padding="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"/>

            <!-- Cart Bottom Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="6dp"
                android:padding="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng thanh toán:"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 đ"
                        android:textSize="18sp"
                        android:textColor="#E53935"
                        android:textStyle="bold"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnClearCart"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Xóa giỏ hàng"
                    android:backgroundTint="#757575"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- TAB 3: TÀI KHOẢN & QUẢN LÝ NGƯỜI DÙNG -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panelAccount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- User Profile Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:src="@drawable/ic_user"
                            app:tint="#E53935"
                            android:background="#FFEBEE"
                            android:padding="14dp"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tvAccountName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quản trị viên"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#212121"/>

                        <TextView
                            android:id="@+id/tvAccountEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="admin@cellphones.vn"
                            android:textSize="13sp"
                            android:textColor="#757575"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="14dp"/>

                        <Button
                            android:id="@+id/btnEditAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="✏️ Đổi thông tin"
                            android:textSize="12sp"
                            android:backgroundTint="#1976D2"
                            android:textColor="#FFFFFF"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Quản lý người dùng Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quản lý người dùng"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>

                    <Button
                        android:id="@+id/btnAddUser"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="+ Thêm"
                        android:textSize="12sp"
                        android:backgroundTint="#E53935"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp"/>

                <!-- Đăng xuất -->
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Đăng xuất"
                    android:textSize="14sp"
                    android:backgroundTint="#757575"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- Bottom Tab Bar (Đã bỏ danh mục, chỉ còn 3 tab chuẩn như ảnh) -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="horizontal">

        <!-- Tab 1: Trang chủ -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivTabHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="#E53935"/>

            <TextView
                android:id="@+id/tvTabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trang chủ"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#E53935"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Tab 2: Giỏ hàng -->
        <LinearLayout
            android:id="@+id/tabCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivTabCart"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_cart"
                app:tint="#757575"/>

            <TextView
                android:id="@+id/tvTabCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giỏ hàng"
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Tab 3: Tài khoản -->
        <LinearLayout
            android:id="@+id/tabAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivTabAccount"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                app:tint="#757575"/>

            <TextView
                android:id="@+id/tvTabAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản"
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
