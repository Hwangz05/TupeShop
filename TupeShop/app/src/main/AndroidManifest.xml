<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cellphonesclone">

        <activity
            android:name=".activity.LoginActivity"
            android:exported="true"
            android:label="Đăng nhập">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.RegisterActivity"
            android:label="Đăng ký" />

        <activity
            android:name=".activity.MainActivity"
            android:label="@string/app_name" />

        <activity
            android:name=".activity.ProductFormActivity"
            android:label="Sản phẩm"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.ProductDetailActivity"
            android:label="Chi tiết sản phẩm"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.CartActivity"
            android:label="Giỏ hàng"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.UserFormActivity"
            android:label="Người dùng"
            android:parentActivityName=".activity.MainActivity" />

    </application>

</manifest>
